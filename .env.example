# Copy to .env and fill in.

# Database (SQLite file). In Docker this points to the mounted volume.
DATABASE_URL="file:./dev.db"

# Auth – generate a secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Stripe (Dashboard → Developers → API keys). Use sk_test_... while testing.
STRIPE_SECRET_KEY=""
# Dashboard → Developers → Webhooks → endpoint https://yourdomain.com/api/stripe/webhook/  (keep the trailing slash)
# Events: checkout.session.completed, customer.subscription.created/updated/deleted
STRIPE_WEBHOOK_SECRET=""
# Dashboard → Product catalogue → create "NexPDF Pro" with a monthly and a yearly recurring price.
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_YEARLY=""

# Path to LibreOffice for Word/Excel/PowerPoint → PDF (auto-detected if on PATH; set in Docker).
SOFFICE_PATH=""

# Server limits for Pro jobs (optional; defaults shown).
# PRO_DAILY_LIMIT="200"
# MAX_CONCURRENT_JOBS="2"
# MAX_QUEUED_JOBS="20"
# JOB_TIMEOUT_SECONDS="180"

# Local development only: shows an "Activate test subscription" button that skips Stripe.
# Ignored when NODE_ENV=production.
ENABLE_TEST_BILLING="true"
NEXT_PUBLIC_ENABLE_TEST_BILLING="true"
