{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=softservices.db"
  },

  "Auth": {
    "Secret": "",
    "Issuer": "SoftServices.Api",
    "TokenDays": 30
  },

  "App": {
    "SiteName": "SoftServices",
    "FrontendUrl": "http://localhost:3000",
    "CorsOrigins": [ "http://localhost:3000" ],
    "DevAdminEmails": [],
    "EnableTestBilling": false
  }
}
