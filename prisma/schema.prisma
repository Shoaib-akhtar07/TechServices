// SQLite for local/dev and single-server Docker deploys.
// For a managed database, change provider to "postgresql" and DATABASE_URL.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  name             String?
  passwordHash     String
  stripeCustomerId String?       @unique
  createdAt        DateTime      @default(now())
  subscription     Subscription?
  usage            Usage[]
}

// Pro jobs per user per UTC day, for the fair-use limit.
model Usage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    String // YYYY-MM-DD (UTC)
  count  Int    @default(0)

  @@unique([userId, day])
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSubscriptionId String?  @unique
  // Stripe status: active | trialing | past_due | canceled | incomplete | unpaid ...
  status               String
  // monthly | yearly
  plan                 String
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)
  updatedAt            DateTime @updatedAt
}
