# Copy to .env and fill in.

# The .NET backend (SoftServices.Api). Only this Next.js server calls it — it does not need to be public.
API_URL="http://localhost:5087"

# Auth – generate a secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Accounts, payments (Stripe / PayPal / manual), prices, limits and blog posts are all managed by the
# .NET API through the admin panel (/admin/). Payment keys are entered in Admin → Settings.

# Path to LibreOffice for Word/Excel/PowerPoint → PDF (auto-detected if on PATH; set in Docker).
SOFFICE_PATH=""

# Server limits for Pro jobs (optional; defaults shown). The daily limit is set in the admin panel.
# MAX_CONCURRENT_JOBS="2"
# MAX_QUEUED_JOBS="20"
# JOB_TIMEOUT_SECONDS="180"

# Local development only: shows "Activate test subscription" (the API needs App:EnableTestBilling too).
ENABLE_TEST_BILLING="true"
NEXT_PUBLIC_ENABLE_TEST_BILLING="true"
